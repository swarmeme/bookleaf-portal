# Copy to .env and fill in. Never commit .env.

# Secret used to sign login tokens. Use any long random string (32+ characters), e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# Google Gemini API key (free tier: https://aistudio.google.com/apikey).
# Optional: without it the app runs in fallback mode (keyword triage, admins write replies manually).
GEMINI_API_KEY=

# Models. Triage is a short structured task, so it uses the cheapest model; drafting uses a stronger one.
GEMINI_CLASSIFY_MODEL=gemini-3.5-flash-lite
GEMINI_DRAFT_MODEL=gemini-3.8-flash
# Thinking adds latency and uses up the output limit; LOW suits these well-specified tasks.
GEMINI_THINKING_LEVEL=LOW

# AI resilience: request timeout, retries on rate limits/5xx, and how long to stop calling the AI
# after repeated failures.
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2
AI_COOLDOWN_SECONDS=60

# The sample dataset's royalty dates are from 2025. Pinning "today" keeps
# payout-date calculations sensible for the demo. Leave empty to use the real date.
AS_OF_DATE=2026-01-20

# Defaults to backend/bookleaf.db
# DATABASE_URL=sqlite:///./bookleaf.db
