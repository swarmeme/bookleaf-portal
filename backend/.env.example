# Copy to .env and fill in. Never commit .env.

# Secret used to sign login tokens. Use any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Google Gemini API key (free tier: https://aistudio.google.com).
# Optional: without it the app runs in fallback mode (keyword classification,
# admins write replies manually).
GEMINI_API_KEY=

# The sample dataset's royalty dates are from 2025. Pinning "today" keeps
# payout-date calculations sensible for the demo. Leave empty to use the real date.
AS_OF_DATE=2026-01-20
